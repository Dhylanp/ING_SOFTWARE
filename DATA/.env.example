# --- Base de datos (Railway los inyecta solos) ---
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# --- Sesión ---
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Correo (HU15, HU17, HU23). Si SMTP_HOST queda vacío los correos se
#     "simulan": quedan registrados en la tabla notificacion_correo ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=interconsultas@tu-dominio.cl
SMTP_TLS=1
SMTP_SSL=0
# Correo de respaldo cuando el CESFAM no tiene uno registrado
CESFAM_CORREO_DEFAULT=

# 0 = no aplicar la migración automática del Sprint 3 al arrancar
AUTO_MIGRAR=1
